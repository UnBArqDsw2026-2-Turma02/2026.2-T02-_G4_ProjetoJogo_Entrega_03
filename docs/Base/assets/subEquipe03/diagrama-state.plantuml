@startuml Diagrama_state

left to right direction

skinparam classAttributeIconSize 0
skinparam style strictuml
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 100
skinparam BackgroundColor #FFFFFF
skinparam padding 10
skinparam ArrowThickness 1.5

skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #343A40
    ArrowColor #495057
}

skinparam package {
    BorderThickness 2
    Padding 20
}

package "State - Pomodoro" as PPomodoro {

    together {
        interface EstadoPomodoro <<interface>> {
            + iniciarCiclo(sessao: SessaoPomodoro): void
            + pausarCiclo(sessao: SessaoPomodoro): void
            + retomarCiclo(sessao: SessaoPomodoro): void
            + finalizarCicloComSucesso(sessao: SessaoPomodoro): void
            + calcularRecompensaExperiencia(sessao: SessaoPomodoro): float
        }

        class EstadoConfigurando implements EstadoPomodoro {
            + iniciarCiclo(sessao: SessaoPomodoro): void
            + pausarCiclo(sessao: SessaoPomodoro): void
            + retomarCiclo(sessao: SessaoPomodoro): void
            + finalizarCicloComSucesso(sessao: SessaoPomodoro): void
            + calcularRecompensaExperiencia(sessao: SessaoPomodoro): float
        }

        class PomodoroFocoEmAndamento implements EstadoPomodoro {
            + iniciarCiclo(sessao: SessaoPomodoro): void
            + pausarCiclo(sessao: SessaoPomodoro): void
            + retomarCiclo(sessao: SessaoPomodoro): void
            + finalizarCicloComSucesso(sessao: SessaoPomodoro): void
            + calcularRecompensaExperiencia(sessao: SessaoPomodoro): float
        }

        class PomodoroPausado implements EstadoPomodoro {
            + iniciarCiclo(sessao: SessaoPomodoro): void
            + pausarCiclo(sessao: SessaoPomodoro): void
            + retomarCiclo(sessao: SessaoPomodoro): void
            + finalizarCicloComSucesso(sessao: SessaoPomodoro): void
            + calcularRecompensaExperiencia(sessao: SessaoPomodoro): float
        }

        class PomodoroConcluido implements EstadoPomodoro {
            + iniciarCiclo(sessao: SessaoPomodoro): void
            + pausarCiclo(sessao: SessaoPomodoro): void
            + retomarCiclo(sessao: SessaoPomodoro): void
            + finalizarCicloComSucesso(sessao: SessaoPomodoro): void
            + calcularRecompensaExperiencia(sessao: SessaoPomodoro): float
        }
    }

    class SessaoPomodoro {
        - estadoAtual: EstadoPomodoro
        + setEstado(novoEstado: EstadoPomodoro): void
        + iniciarCiclo(): void
        + pausarCiclo(): void
        + retomarCiclo(): void
        + finalizarCicloComSucesso(): void
        + calcularRecompensaExperiencia(): float
    }
}

package "State - Pet" as PPet {

    together {
        interface EstadoPet <<interface>> {
            + processarExperiencia(pet: PetVirtual, categoria: CategoriaXP, pontos: float): void
            + avaliarEvolucao(pet: PetVirtual): void
            + getNomeFase(): String
        }

        class EstadoBebe implements EstadoPet {
            + processarExperiencia(pet: PetVirtual, categoria: CategoriaXP, pontos: float): void
            + avaliarEvolucao(pet: PetVirtual): void
            + getNomeFase(): String
        }

        class EstadoCrianca implements EstadoPet {
            + processarExperiencia(pet: PetVirtual, categoria: CategoriaXP, pontos: float): void
            + avaliarEvolucao(pet: PetVirtual): void
            + getNomeFase(): String
        }

        class EstadoAdolescente implements EstadoPet {
            + processarExperiencia(pet: PetVirtual, categoria: CategoriaXP, pontos: float): void
            + avaliarEvolucao(pet: PetVirtual): void
            + getNomeFase(): String
        }

        class EstadoAdulto implements EstadoPet {
            + processarExperiencia(pet: PetVirtual, categoria: CategoriaXP, pontos: float): void
            + avaliarEvolucao(pet: PetVirtual): void
            + getNomeFase(): String
        }

        class PetVirtual {
            - estadoAtual: EstadoPet
            + setEstado(novoEstado: EstadoPet): void
            + acumularExperiencia(categoria: CategoriaXP, pontosXp: float): void
            + avaliarEvolucaoPorAfinidade(): void
        }
    }
}

enum CategoriaXP <<enumeration>> {
    INTELECTUAL
    SABEDORIA
    ZEN
    ATLETICO
    HIDRATACAO
}

' Relacionamentos do State

SessaoPomodoro "1" --> "1" EstadoPomodoro
PetVirtual "1" --> "1" EstadoPet 
EstadoPomodoro ..> SessaoPomodoro
EstadoPet ..> PetVirtual

' Estado inicial da sessao Pomodoro

note top of SessaoPomodoro
    Estado inicial:
    EstadoConfigurando
end note

EstadoPomodoro ..> CategoriaXP
EstadoPet ..> CategoriaXP
PetVirtual ..> CategoriaXP

' Orientacao do layout dos packages

PPomodoro -[hidden]right- PPet

' Agrupamento e posicionamento interno

EstadoPomodoro -[hidden]down- EstadoConfigurando
EstadoConfigurando -[hidden]right- PomodoroFocoEmAndamento
PomodoroFocoEmAndamento -[hidden]right- PomodoroPausado
PomodoroPausado -[hidden]right- PomodoroConcluido

EstadoPet -[hidden]down- EstadoBebe
EstadoBebe -[hidden]right- EstadoCrianca
EstadoCrianca -[hidden]right- EstadoAdolescente
PetVirtual -[hidden]right- EstadoPet

@enduml